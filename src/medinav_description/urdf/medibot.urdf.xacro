<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="medibot">

  <!-- controller yaml path injected by launch -->
  <xacro:arg name="controller_yaml" default="/opt/ros/humble/share/diff_drive_controller/config/diff_drive_controller.yaml"/>

  <!-- ===================== Properties ===================== -->
  <xacro:property name="M_PI" value="3.141592653589793"/>
  <xacro:property name="wheel_radius" value="0.048"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheel_separation" value="0.32"/>
  <xacro:property name="chassis_length" value="0.42"/>
  <xacro:property name="chassis_width" value="0.28"/>
  <xacro:property name="chassis_height" value="0.12"/>
  <xacro:property name="chassis_mass" value="4.5"/>
  <xacro:property name="wheel_mass" value="0.35"/>
  <xacro:property name="lidar_mass" value="0.25"/>
  <xacro:property name="payload_mass" value="0.5"/>
  <xacro:property name="ground_clearance" value="0.05"/>

  <!-- ===================== Materials ===================== -->
  <material name="medinav_grey">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>
  <material name="medinav_blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>
  <material name="medinav_white">
    <color rgba="0.92 0.92 0.95 1.0"/>
  </material>
  <material name="medinav_orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>
  <material name="medinav_black">
    <color rgba="0.08 0.08 0.10 1.0"/>
  </material>

  <!-- ===================== Macros ===================== -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(y*y+z*z)}" ixy="0.0" ixz="0.0"
               iyy="${mass/12.0*(x*x+z*z)}" iyz="0.0"
               izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
               iyy="${mass/12.0*(3*r*r+h*h)}" iyz="0.0"
               izz="${mass/2.0*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="medinav_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
      <material>Gazebo/Black</material>
    </gazebo>
    <ros2_control name="${prefix}_wheel_joint" type="system">
      <!-- placeholder removed; full ros2_control block is at robot level -->
    </ros2_control>
  </xacro:macro>

  <!-- ===================== Chassis ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="medinav_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ===================== Wheels ===================== -->
  <!-- Inline wheels (macros above keep file readable; joints here for clarity) -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="medinav_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation/2} ${wheel_radius - chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="left_wheel_link">
    <mu1>1.2</mu1><mu2>1.2</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="medinav_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_separation/2} ${wheel_radius - chassis_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="right_wheel_link">
    <mu1>1.2</mu1><mu2>1.2</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Caster -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="medinav_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.12" r="0.03" h="0.03"/>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-chassis_length/2 + 0.04} 0 ${0.03 - chassis_height/2}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_link">
    <mu1>0.05</mu1><mu2>0.05</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===================== Payload box ===================== -->
  <link name="payload_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
      <material name="medinav_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${payload_mass}" x="0.18" y="0.16" z="0.12"/>
  </link>
  <joint name="payload_joint" type="fixed">
    <parent link="base_link"/>
    <child link="payload_link"/>
    <origin xyz="0.02 0 ${chassis_height/2 + 0.06}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 2D LiDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
      <material name="medinav_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="${lidar_mass}" r="0.035" h="0.045"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 ${chassis_height/2 + 0.045}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo GPU/CPU lidar sensor -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.012</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== IMU ===================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="medinav_orange"/>
    </visual>
    <xacro:box_inertia mass="0.02" x="0.02" y="0.02" z="0.01"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== RGB Camera ===================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.06 0.03"/>
      </geometry>
      <material name="medinav_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.06 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="0.05" x="0.03" y="0.06" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 ${chassis_height/2 + 0.08}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=camera/image_raw</remapping>
          <remapping>~/camera_info:=camera/camera_info</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Bumpers / safety ===================== -->
  <link name="bumper_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.02"/>
      </geometry>
      <material name="medinav_orange"/>
    </visual>
    <xacro:box_inertia mass="0.05" x="${chassis_length}" y="${chassis_width}" z="0.02"/>
  </link>
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_link"/>
    <origin xyz="0 0 ${-chassis_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ros2_control ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controller_yaml)</parameters>
    </plugin>
  </gazebo>

</robot>
