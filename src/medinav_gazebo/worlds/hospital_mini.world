    <!-- Dynamic obstacle (simple box "pedestrian") -->
    <model name="pedestrian_box">
      <static>false</static>
      <pose>-4 0 0.45 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.35 0.35 0.9</size></box></geometry>
          <material><diffuse>0.9 0.55 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.35 0.35 0.9</size></box></geometry>
        </collision>
        <inertial>
          <mass>25</mass>
          <inertia>
            <ixx>1.2</ixx><iyy>1.2</iyy><izz>1.2</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
