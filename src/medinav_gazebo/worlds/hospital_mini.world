<?xml version="1.0"?>
<sdf version="1.7">
  <world name="hospital_mini">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ===== Corridor floor mark (visual only) ===== -->
    <model name="floor_lane">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="lane">
          <geometry>
            <box>
              <size>12 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box>
              <size>12 0.08 0.002</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===== Pharmacy (origin / home) ===== -->
    <model name="pharmacy">
      <static>true</static>
      <pose>5 0 0 0 0 0</pose>
      <link name="link">
        <visual name="wall_a">
          <pose>0 1.2 0.75 0 0 0</pose>
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
          <material><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <visual name="wall_b">
          <pose>0 -1.2 0.75 0 0 0</pose>
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
          <material><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <visual name="wall_c">
          <pose>1.1 0 0.75 0 0 0</pose>
          <geometry><box><size>0.12 2.5 1.5</size></box></geometry>
          <material><diffuse>0.88 0.90 0.93 1</diffuse></material>
        </visual>
        <visual name="counter">
          <pose>-0.3 0 0.4 0 0 0</pose>
          <geometry><box><size>0.8 1.6 0.8</size></box></geometry>
          <material><diffuse>0.55 0.62 0.72 1</diffuse></material>
        </visual>
        <collision name="c_a">
          <pose>0 1.2 0.75 0 0 0</pose>
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
        </collision>
        <collision name="c_b">
          <pose>0 -1.2 0.75 0 0 0</pose>
          <geometry><box><size>2.2 0.12 1.5</size></box></geometry>
        </collision>
        <collision name="c_c">
          <pose>1.1 0 0.75 0 0 0</pose>
          <geometry><box><size>0.12 2.5 1.5</size></box></geometry>
        </collision>
        <collision name="c_counter">
          <pose>-0.3 0 0.4 0 0 0</pose>
          <geometry><box><size>0.8 1.6 0.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ===== Corridor outer walls ===== -->
    <model name="corridor_north">
      <static>true</static>
      <pose>0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>10 0.12 1.5</size></box></geometry>
          <material><diffuse>0.9 0.91 0.93 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>10 0.12 1.5</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="corridor_south">
      <static>true</static>
      <pose>0 -1.5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>10 0.12 1.5</size></box></geometry>
